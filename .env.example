# Langfuse (per-tool-call tracing from the local Claude Code CLI) — V3 Phase 0,
# Fleet Playbook Move 2. Used by scripts/langfuse-trace.sh (the PostToolUse
# hook wired in .claude/hooks.json). Keys live in your local shell env
# (~/.zshrc) and, if the app ever calls Langfuse server-side, in Vercel/Fly
# secrets. NEVER commit real values; .env is gitignored. If unset the hook
# fails open and emits no trace. See docs/ops/langfuse-tracing.md.
LANGFUSE_HOST=https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
