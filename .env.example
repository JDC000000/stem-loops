# Postgres (Supabase)
# Direct connection — used by the worker and by `make migrate`.
DATABASE_URL=postgresql://user:pass@host:5432/dbname
# Pooled connection (pgbouncer, transaction mode) — used by serverless Next.js API routes.
DATABASE_URL_POOLED=postgresql://user:pass@host:6543/dbname?pgbouncer=true

# pg-boss queue runs on DATABASE_URL — no separate queue service.

# Replicate API (stem separation — htdemucs_6s, GPU)
REPLICATE_API_TOKEN=
# Rolling 24h spend ceiling (USD). Admission control blocks new jobs above this — defends the budget.
REPLICATE_SPEND_CEILING_USD=10

# Cloudflare R2 (S3-compatible object storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=stem-loops
R2_PUBLIC_URL=https://your-r2-domain.example.com

# Cobalt instance (S1 — YouTube download primary path)
COBALT_URL=https://stem-loops-cobalt.fly.dev

# yt-dlp cookie rotation (S1 fallback — server-side ONLY, NEVER exposed to users)
YTDLP_COOKIE_DIR=/run/secrets/yt_cookies

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
JOB_SHARE_SECRET=           # HMAC key for signed shareable job URLs

# App-generated secrets (provision with: openssl rand -hex 32)
IP_HASH_KEY=                # Keyed HMAC-SHA256 for IP hashing (rate-limit; never store raw IPs)
HISTORY_COOKIE_KEY=         # HMAC-SHA256 signing key for the anonymous history cookie

# Better Stack (monitoring + log drain)
BETTERSTACK_SOURCE_TOKEN=

# Local dev (MinIO — R2 emulator brought up by docker-compose.dev.yml)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://localhost:9000
