{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@stem-loops/types": ["../../packages/types/src/index.ts"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "comment_exclude": "SubmitForm is the YouTube-link form (parked post-launch) and imports contract exports that no longer exist; excluded so the file-upload MVP builds. JobProgress/LoopCard/LoopResults/zipLoops are WIRED into the upload results/progress pages.",
  "exclude": ["node_modules", "src/components/SubmitForm.tsx"]
}
