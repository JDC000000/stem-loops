# Klangio — Y1 chord-recognition bridge (V3 Phase 2 Y1).
# See claude/phase-2-y1-chord-model-decision.md v1.1 (hybrid path E: 1-billing-
# cycle Klangio bridge in parallel with own-model training). HARD CAP: swap or
# flip off CHORDS_PROVIDER='' at the end of the billing cycle. Obtain a key at
# klang.io/account. Server-side only (worker). If unset the worker logs
# `chords_skipped_disabled` and the Y1 overlay degrades to "no chords".
# Docs: docs/ops/chord-recognition.md.
KLANGIO_API_KEY=
# Chord provider selector: 'klangio' (default) | 'replicate' | 'internal'.
# Set to empty string to DISABLE chord recognition (useful for Gate-2 fixture
# runs that must not call the provider).
CHORDS_PROVIDER=klangio

# Replicate
REPLICATE_API_TOKEN=
# Pinned demucs model version (NON-secret ryan5453/demucs hash). Defaulted in code;
# set here / in the Fly worker deploy config to override the pinned version.
REPLICATE_MODEL_VERSION=5a7041cc9b82e5a558fea6b3d7b12dea89625e89da33f0447bd727c2d0ab9e77
REPLICATE_DEMUCS_MODEL=htdemucs_6s

# Cloudflare R2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=

# Supabase / Postgres
DATABASE_URL=
DATABASE_POOL_URL=

# Better Stack
BETTERSTACK_SOURCE_TOKEN=

# App-generated secrets (run: openssl rand -hex 32)
IP_HASH_KEY=
HISTORY_COOKIE_KEY=

# Resend (transactional email) — V3 Phase 1a, TSD §M
# Obtain at resend.com/api-keys. Server-side only. If unset, emails are
# skipped (webhook continues; warn logged).
RESEND_API_KEY=
# Optional override. Default: "stem-loops <notifications@stem-loops.com>".
# Set to blank and RESEND_SANDBOX=1 to send from Resend's shared sandbox
# address while the domain isn't verified yet.
RESEND_FROM=
RESEND_SANDBOX=

# hCaptcha (bot protection on signup + credits purchase) — V3 Phase 1b, TSD §1.1.
# Obtain at hcaptcha.com → Dashboard → Sites → add stem-loops-staging.vercel.app
# and stem-loops.com. Site key is PUBLIC (shipped to browser); secret stays server-side.
# If either is unset, the UI disables the submit button with "Bot check unavailable"
# and the server fails the challenge closed. Test keys for local dev:
#   NEXT_PUBLIC_HCAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001  (always-pass)
#   HCAPTCHA_SECRET_KEY=0x0000000000000000000000000000000000000000      (always-pass)
HCAPTCHA_SECRET_KEY=

# Local dev (MinIO R2 emulator) - these are set automatically by make dev
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin

# ── Web (browser-visible, build-time) ──
# OPTIONAL. Demo audio host for the landing (trailing slash). Defaults (compiled in) to
# https://myzone-jon-cartwright-stem-loops-demo.crhq.ai/ ; set to override, or set to a single
# space to disable the demo. Layout: demo-assets-v2/{loops.json,song-context.json,{1,2,4,8}bar/*.mp3}
# and assets/{before-peaks.json,drums-8bar.wav}; the host must send CORS for the site's origin.
# If the host is down the landing shows "The sample didn't load"; the tool still works.
# NEXT_PUBLIC_DEMO_ASSET_BASE=https://myzone-jon-cartwright-stem-loops-demo.crhq.ai/

# hCaptcha site key (public — shipped to browser). Pair with HCAPTCHA_SECRET_KEY
# above. See the comment block there for how to provision and the always-pass
# test key for local dev.
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=

# Anthropic — routed through Cloudflare AI Gateway (Fleet Playbook Move 1).
# See docs/ops/ai-gateway.md. Set this in Vercel (Preview + Production) and in
# Fly secrets for each worker app; do NOT commit the real URL.
# Placeholder shape:
#   https://gateway.ai.cloudflare.com/v1/<cf-account-id>/<gateway-name>/anthropic
# ANTHROPIC_API_KEY stays unchanged; the Anthropic SDK sends it as x-api-key
# by default — do NOT send Authorization: Bearer on this endpoint.
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=

# ── V3-Y1 training ──
# Only set when running training locally. Not used at runtime by the web/worker apps.
TRAINING_DATA_CACHE_DIR=./apps/training/data/cache
TRAINING_MODAL_GPU_ARCH=l4           # l4 | a10 | a100-40 | a100-80
<<<<<<< HEAD
# Synthetic-render soundfont slug. One of: fluidr3 (MIT, default),
# musescore_general (MIT), vsco2 (CC0-1.0), vcsl (CC0-1.0),
# salamander (CC-BY-3.0, needs attribution). Attribution matrix lives in
# docs/ops/synthetic-render.md. Leave unset to rotate per score.
TRAINING_SOUNDFONT=fluidr3
# Parallel worker count for the synthetic renderer. Each worker holds its
# own FluidSynth instance; 4 is a safe default on an 8-core dev machine.
TRAINING_RENDER_JOBS=4
