# Replicate
REPLICATE_API_TOKEN=
# Pinned demucs model version (NON-secret ryan5453/demucs hash). Defaulted in code;
# set here / in the Fly worker deploy config to override the pinned version.
REPLICATE_MODEL_VERSION=5a7041cc9b82e5a558fea6b3d7b12dea89625e89da33f0447bd727c2d0ab9e77
REPLICATE_DEMUCS_MODEL=htdemucs_6s

# Cloudflare R2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=

# Supabase / Postgres
DATABASE_URL=
DATABASE_POOL_URL=

# Better Stack
BETTERSTACK_SOURCE_TOKEN=

# App-generated secrets (run: openssl rand -hex 32)
IP_HASH_KEY=
HISTORY_COOKIE_KEY=

# Local dev (MinIO R2 emulator) - these are set automatically by make dev
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin

# ── Web (browser-visible, build-time) ──
# Base URL (trailing slash) of the landing's demo audio host. Layout: demo-assets-v2/{loops.json,
# song-context.json,{1,2,4,8}bar/*.mp3} and assets/{before-peaks.json,drums-8bar.wav}. Must send CORS
# (Access-Control-Allow-Origin) for the site's origin. Unset → the landing shows its
# "sample didn't load" state; the tool still works. Audio is never committed to this repo.
NEXT_PUBLIC_DEMO_ASSET_BASE=https://myzone-jon-cartwright-stem-loops-demo.crhq.ai/
