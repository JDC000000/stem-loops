# Local dev env — copy to .env.local (gitignored). Matches docker-compose.dev.yml.
DATABASE_URL=postgresql://stemloops:stemloops@localhost:5432/stemloops
DATABASE_URL_POOLED=postgresql://stemloops:stemloops@localhost:5432/stemloops

# MinIO (R2 emulator)
MINIO_ENDPOINT=http://localhost:9000
R2_ACCOUNT_ID=local
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET_NAME=stem-loops

# App secrets — dev placeholders only; generate real ones with `openssl rand -hex 32` in prod.
IP_HASH_KEY=dev-placeholder-replace-in-prod
HISTORY_COOKIE_KEY=dev-placeholder-replace-in-prod
JOB_SHARE_SECRET=dev-placeholder-replace-in-prod

NEXT_PUBLIC_APP_URL=http://localhost:3000
