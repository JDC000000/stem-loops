.ruff_cache/

# Env
.env
.env.local
.env.*.local

# Claude Code local tooling state — per-session agent worktrees, caches,
# settings. Each dev's workstation generates its own.
# Note the `.claude/*` form (not `.claude/`): git cannot re-include a file
# below an excluded directory, so we exclude only the CONTENTS of .claude/
# and then negate the subpaths we DO want committed:
#   - .claude/agents/     behavioural role definitions (see docs/agent-registry.md)
#   - .claude/hooks.json  PostToolUse hook wiring (see docs/ops/langfuse-tracing.md)
.claude/*
!.claude/agents/
!.claude/hooks.json

# Audio files (fixtures/ are committed; loose audio is not)
*.wav
*.mp3
*.flac
*.ogg
*.aac
*.m4a
!fixtures/**

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Docker volumes
postgres_data/
minio_data/

# V3-Y1 training — downloaded corpora, checkpoints, run artefacts
# (see apps/training/.gitignore for the local scope too)
apps/training/data/cache/
apps/training/data/*/checkpoint-*/
apps/training/data/*/wandb/

# Y1 chord-recognition eval harness — audio cache + per-run reports.
# See docs/ops/chord-recognition.md. The manifest is committed; audio and
# report JSON are per-developer / per-run and never land in git.
apps/worker/.chord-eval-cache/
apps/worker/tests/chord_eval_reports/
# play.chords.json per-job output written by the pipeline (feature-flagged).
apps/worker/outputs/

# Vercel
.vercel/

# TypeScript build info
*.tsbuildinfo
.vercel
.env*
