# Replicate
REPLICATE_API_TOKEN=
# Pinned demucs model version (NON-secret ryan5453/demucs hash). Defaulted in code;
# set here / in the Fly worker deploy config to override the pinned version.
REPLICATE_MODEL_VERSION=5a7041cc9b82e5a558fea6b3d7b12dea89625e89da33f0447bd727c2d0ab9e77
REPLICATE_DEMUCS_MODEL=htdemucs_6s

# Cloudflare R2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=

# Supabase / Postgres
DATABASE_URL=
# Supabase POOLED (pgbouncer, port 6543) connection string. The web app's serverless
# routes use this so concurrent invocations don't exhaust the direct-connection cap.
# NOTE: the name is DATABASE_URL_POOLED — apps/web/src/lib/db.ts reads exactly this.
DATABASE_URL_POOLED=

# Better Stack
BETTERSTACK_SOURCE_TOKEN=

# App-generated secrets (run: openssl rand -hex 32)
IP_HASH_KEY=
HISTORY_COOKIE_KEY=

# Local dev (MinIO R2 emulator) - these are set automatically by make dev
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin
