{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@stem-loops/types": ["../../packages/types/src/index.ts"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "comment_exclude": "Orphaned Phase-3 UX components (waveform/zip) are out of sync with the generated types and need a type-sync + dep pass (wavesurfer.js/jszip). They are NOT imported by any route and are excluded so the file-upload MVP builds. Re-include when Phase-3 UX is rebuilt.",
  "exclude": [
    "node_modules",
    "src/components/JobProgress.tsx",
    "src/components/LoopCard.tsx",
    "src/components/LoopResults.tsx",
    "src/components/SubmitForm.tsx",
    "src/lib/zipLoops.ts"
  ]
}
