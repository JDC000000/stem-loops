# Postgres (Supabase)
DATABASE_URL=

# pg-boss queue (uses DATABASE_URL)
# No separate config needed

# Replicate API
REPLICATE_API_TOKEN=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Cobalt instance (S1 spike — YouTube download primary)
COBALT_URL=

# YouTube fallback (S1 spike — yt-dlp cookie path, server-managed)
YTDLP_COOKIE_PATH=

# App
NEXT_PUBLIC_APP_URL=
JOB_SHARE_SECRET=           # For signed shareable job URLs
RATE_LIMIT_FINGERPRINT_KEY= # For keyed-HMAC IP hashing

# App-generated secrets (provision with: openssl rand -hex 32)
IP_HASH_KEY=
HISTORY_COOKIE_KEY=

# Better Stack (monitoring)
BETTERSTACK_SOURCE_TOKEN=

# Local dev (MinIO R2 emulator)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
